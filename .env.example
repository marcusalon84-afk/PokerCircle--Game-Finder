# GEMINI_API_KEY: Optional/Server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Environment Mode
NODE_ENV="development"

# Admin email for notifications and moderation
ADMIN_EMAIL="alon.pokercircle@gmail.com"

